{
  "name": "@dsh-external/dsh-session-folders",
  "version": "0.3.1",
  "description": "Session folders: organize sidebar conversations into nested, color-coded folders (context menu, drag-drop, batch select, colored tree guides)",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  }
}
