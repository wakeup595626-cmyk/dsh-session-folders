{
  "name": "@dsh-external/dsh-session-folders",
  "version": "0.3.1",
  "description": "Session folders for the DeepSeek Harness Web sidebar. | 中文：DSH Web 侧栏会话分组：可嵌套、可自定义颜色图标的文件夹。",
  "private": true,
  "type": "module",
  "main": "./lib/index.js",
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "scripts": {
    "build": "bash scripts/build.sh",
    "build:client": "node scripts/build-client.mjs"
  },
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-api-session-controller",
        "@deepseek-ai/dsh-api-workspace-controller"
      ],
      "platform": "web"
    }
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "sessions",
    "folders"
  ],
  "homepage": "https://github.com/wakeup595626-cmyk/dsh-session-folders#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/wakeup595626-cmyk/dsh-session-folders.git"
  },
  "bugs": {
    "url": "https://github.com/wakeup595626-cmyk/dsh-session-folders/issues"
  },
  "author": "wakeUp595626-cmyk"
}
